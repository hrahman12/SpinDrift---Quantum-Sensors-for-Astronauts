.vercel/
node_modules/
.env
.env.*
!.env.example

.vercel
# secrets: tokens and API keys come from environment variables only (VIRES_TOKEN etc.)
*.token
secrets*
.viresclient.ini
# local caches and raw downloads (never committed)
cache/
__pycache__/
*.pyc
*.tmp

# Lean build output (recreate with: cd lean && lake build)
lean/.lake/

# Vercel build output (scripts/vercel_build.sh)
public/
# literature-builder raw API cache (scripts/build_literature.py; over 20 MB)
data/literature/raw/
.env*

# HyperFrames working files and renders (slides/front_page)
.hyperframes/
slides/front_page/*.mp4
slides/front_page/spindrift_front_*.png
