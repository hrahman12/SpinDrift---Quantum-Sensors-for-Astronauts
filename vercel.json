{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "bash scripts/vercel_build.sh",
  "outputDirectory": "public",
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "includeFiles": "{server/**,lean/SpinDrift.lean,lean/Main.lean,lean/lean-toolchain,lean/SpinDrift/**,lean/.lake/build/bin/**,data/locations.json,data/specs.json,data/nv_heart_derived.json,data/lean_proofs.json,data/live_snapshot.json,data/runs.json,data/combined_sensor.json,data/recorded/opm_brain_mne.json}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/", "destination": "/ui/index.html" }
  ],
  "headers": [
    { "source": "/ui/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/data/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
